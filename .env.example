API_IMAGE=ghcr.io/minjun916/portfolio-be:latest
POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
POSTGRES_PASSWORD=replace_with_random_hex
# Compose API: db / local Node.js: 127.0.0.1
DATABASE_URL=postgresql://portfolio:replace_with_random_hex@db:5432/portfolio
# Swagger를 사용하는 API Origin과 이후 관리자 웹 Origin을 정확히 지정합니다.
ADMIN_ORIGINS=http://localhost:3000
