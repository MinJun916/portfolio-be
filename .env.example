API_IMAGE=ghcr.io/minjun916/portfolio-be:latest

POSTGRES_USER=portfolio
POSTGRES_DB=portfolio
POSTGRES_PASSWORD=replace_with_random_hex

# Compose API: db / local Node.js: 127.0.0.1
DATABASE_URL=postgresql://portfolio:replace_with_random_hex@db:5432/portfolio

# openssl rand -hex 32로 생성한 값. 운영 서버에서만 보관합니다.
JWT_SECRET=

# 브라우저 API 호출을 허용할 프론트 Origin. Swagger는 API와 같은 Origin입니다.
CORS_ORIGINS=http://localhost:3000
